# ==============================================================================
# Instagram Outreach OS - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin Email Allowlist (comma separated)
ADMIN_EMAILS=paritosh@example.com

# ------------------------------------------------------------------------------
# 2. Instagram Discovery Provider (Apify API)
# ------------------------------------------------------------------------------
# Leave empty to run with the built-in $0 Sandbox Simulator
APIFY_API_TOKEN=apify_api_token_here
APIFY_ACTOR_ID=apify/instagram-profile-scraper

# ------------------------------------------------------------------------------
# 3. Cost Controls & Rate Limits (Strictly Enforced Server-Side)
# ------------------------------------------------------------------------------
# Monthly dollar ceiling for Apify scraping (Target: $0 out of pocket / free credits)
APIFY_MONTHLY_BUDGET_USD=4.50

# Maximum qualified prospects admitted to the outreach queue per day
MAX_DAILY_QUALIFIED_LEADS=60

# Maximum raw profiles fetched per discovery run
MAX_RAW_PROFILES_PER_RUN=150

# Default follower ceiling for qualified micro-creators
MAX_FOLLOWERS=20000

# ------------------------------------------------------------------------------
# 4. Meta Instagram Official Messaging Webhook (Automatic Reply Tracking)
# ------------------------------------------------------------------------------
# Verification token entered in Meta Developer Webhook setup
META_VERIFY_TOKEN=vault_outreach_meta_token_2026
